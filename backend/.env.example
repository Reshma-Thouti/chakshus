# Copy this file to .env and fill in your values.
# The .env file is git-ignored and should NEVER be committed.

# ── MongoDB ──────────────────────────────────────────────────
# Use a local URI for development, Atlas URI for production
MONGO_URI=mongodb://127.0.0.1:27017/diabetic_vision_db

# ── Express Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Python ML Microservice ───────────────────────────────────
# This will be used in Phase 3 when the FastAPI service is running
ML_SERVICE_URL=http://127.0.0.1:8000

# ── File Upload ──────────────────────────────────────────────
# Max file size for fundus images in bytes (default: 10 MB)
MAX_FILE_SIZE_BYTES=10485760
